# uv run python -m assistant init 自动生成令牌。服务器从仓库根目录读取 .env。
WORKSPACE_TOKEN=
ASSISTANT_DB=data/echo.sqlite3

# 默认使用本机 Qwen3.5-2B（standard）。小内存设备可选 lite，见 docs/local-model.md。
MODEL_BASE_URL=http://127.0.0.1:18081/v1
MODEL_NAME=qwen-local
MODEL_API_KEY=
MODEL_MAX_OUTPUT_TOKENS=768
MODEL_MAX_TOKENS_FIELD=max_tokens
MODEL_INPUT_USD_PER_MILLION=0
MODEL_OUTPUT_USD_PER_MILLION=0
# 外部推理模型按文档配置包含隐藏推理的最大计费输出。xAI 必填。
# MODEL_BILLABLE_OUTPUT_CEILING_TOKENS=...
ASSISTANT_BUDGET_USD=50000

# 留空使用中文维基百科。配置支持 JSON 的 SearXNG 以启用多站点搜索。
SEARXNG_BASE_URL=
# 可选 chromium 使用隔离的只读浏览器打开官方百科条目，见 docs/browser.md。
RESEARCH_READER=api
# RESEARCH_CHROMIUM_PATH=/usr/bin/chromium

# 腾讯 QQ 开放平台机器人。
QQ_APP_ID=
QQ_APP_SECRET=

# 确定性 CSV 运算使用本机进程，亦可选用已准备好的隔离 Linux 容器。
ECHO_TABLE_RUNTIME=local
# ECHO_TABLE_IMAGE_ID=sha256:...

# 可选图形工作区。填入在当前主机构建的桌面镜像完整不可变 ID 后启用。
# ECHO_DESKTOP_IMAGE_ID=sha256:...
