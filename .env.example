APP_ENV=dev
TIMEZONE=Asia/Shanghai

# runtime data under repo root ./data (gitignored)
DATA_DIR=./data

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

CHROMA_PERSIST_DIR=./data/chroma

# limits
CANDIDATE_STOCK_LIMIT=30
FULL_MARKET_MIN_ROWS=3500
BACKTEST_MAX_DAYS=60
WHATIF_MAX_HOPS=3
WHATIF_MAX_ITEMS=5
GRAPH_TTL_DAYS=30
STARTUP_BACKFILL_MAX_SECONDS=3
TTL_DAYS_KEEP_HOT=30
TTL_DELETE_BATCH_SIZE=1000
TTL_MAX_SKIP_PER_RUN=5

# logs
METRICS_LOG_PATH=./data/logs/metrics.log
FALLBACK_FAILURES_LOG_PATH=./data/logs/fallback_failures.log

# local scripts
GUPIAO_API_BASE_URL=http://127.0.0.1:8000

# LLM (OpenAI-compatible)
USE_CREWAI=false
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECS=600
LLM_REGEN_ENABLED=true
LLM_REGEN_MAX_ROUNDS=3
LLM_EXTRACT_MAX_WORKERS=3

LLM_CHEAP_BASE_URL=http://localhost:8080/v1
LLM_CHEAP_API_KEY=sk-3809aefa0050e57ff804482aed94bc96f5e382fccdf7b76b1f95a08321d8c8cb
LLM_CHEAP_MODEL=gpt-5.4-mini


LLM_SMART_BASE_URL=http://localhost:8080/v1
LLM_SMART_API_KEY=sk-3809aefa0050e57ff804482aed94bc96f5e382fccdf7b76b1f95a08321d8c8cb
LLM_SMART_MODEL=gpt-5.5
CAUSAL_SIGNAL_BATCH_SIZE=1
CAUSAL_SIGNAL_LLM_REQUEST_TIMEOUT_MS=120000
REASON_AGENT_TIMEOUT_SECS=600
REASON_AGENT_MAX_TOOL_CALLS=16
REASON_AGENT_SHELL_TIMEOUT_SECS=30
REASON_AGENT_HTTP_TIMEOUT_SECS=15
LLM_COST_GUARD_ENABLED=true
LLM_TRACE_BUDGET_USD=0.5
TRACE_RUNTIME_ENABLED=true
DRIFT_GUARD_ENABLED=true
TRACE_SSE_POLL_INTERVAL_MS=1000
TRACE_SSE_HEARTBEAT_INTERVAL_MS=10000

# Causal Tree v2
CAUSAL_TREE_ENABLED=true
CAUSAL_TREE_BEAM_WIDTH=64
CAUSAL_TREE_STATE_BUDGET=20000
CAUSAL_TREE_TIME_BUDGET_MS=2500
CAUSAL_TREE_MIN_PATH_SCORE=0.18
CAUSAL_TREE_REVERSE_ENABLED=true
CAUSAL_TREE_LLM_EDGE_PATCH_ENABLED=true

CAUSAL_SIGNAL_EXTRACTOR=llm

# TickFlow market data
TICKFLOW_API_KEY=
TICKFLOW_BASE_URL=https://api.tickflow.org
