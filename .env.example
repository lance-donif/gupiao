# Infrastructure
DATABASE_URL=postgresql://gupiao:password@localhost:5432/gupiaodb
REDIS_URL=redis://localhost:6379/0
# 生产 compose 必填（docker-compose.production.yml 校验）
POSTGRES_PASSWORD=change-me

# HTTP shell（backend/src/http/server.ts，默认 127.0.0.1:8787）
HOST=127.0.0.1
PORT=8787
NODE_ENV=development
# 覆盖后端根目录解析（默认取进程 cwd），一般不需要设
# BACKEND_ROOT_DIR=

# AI: every Chat Completions call shares one ordered provider/model list.
# Copy backend/ai-config.example.json to backend/tmp/ai-config.json and edit it.
# Relative to the backend process working directory; restart after editing.
# Missing/unreadable file = fail fast, no fallback (see AGENTS.md Core Rules).
AI_CONFIG_FILE=tmp/ai-config.json
# 自选股关键词生成 LLM 超时（默认 60000）
AI_STOCK_KEYWORD_TIMEOUT_MS=60000
# 集成测试专用库（不设则集成测试跳过）
# AI_TEST_DATABASE_URL=postgresql://gupiao:password@localhost:5432/gupiaodb_test

# Causal signal extraction
CAUSAL_SIGNAL_EXTRACTOR=llm
# v3 逐条结果协议为默认；仅调试旧报文时才设为 legacy。
CAUSAL_PROTOCOL_MODE=items
CAUSAL_SIGNAL_BATCH_SIZE=50
CAUSAL_SIGNAL_LLM_REQUEST_TIMEOUT_MS=120000
# LLM 请求体上限（默认 240000，硬上限，见 AGENTS.md）
CAUSAL_SIGNAL_LLM_MAX_REQUEST_CHARS=240000
# 涨停证据初始化 LLM 请求体上限（不设则不限）
# EXPOSURE_CANDIDATE_MAX_REQUEST_CHARS=240000

# 推荐链路配方与阶段执行器（默认即生产强制切换值）
SCORING_RECIPE=event-v2
PIPELINE_STAGE_EXECUTOR=registry

# 流水线通用
# 多租户集群键（默认 global）
CLUSTER_KEY=global
# 新闻源模式：baseline | expanded（默认 expanded）
NEWS_SOURCE_MODE=expanded
# 生产库写保护：import-trading-calendar 等脚本需 --allow-production 或设为 1
# ALLOW_PRODUCTION_WRITES=0

# AKTools market data
AKTOOLS_BASE_URL=http://127.0.0.1:8010
AKTOOLS_BOARD_LIMIT=20
AKTOOLS_SYMBOL_LIMIT=20
AKTOOLS_MAX_RESULTS=10000

# 行情同步调参（scripts/sync-stock-history.ts，CLI 参数优先）
STOCK_HISTORY_AKTOOLS_CONCURRENCY=32
STOCK_HISTORY_YAHOO_CONCURRENCY=16
STOCK_HISTORY_MAX_RETRIES=2
STOCK_HISTORY_YAHOO_FALLBACK=false
# 股票清单同步上限（0 = 不限，scripts/sync-stocks.ts）
STOCK_SYNC_LIMIT=0
# 股票清单快速同步（true 跳过慢步骤）
FAST_SYNC=false

# NewsNow fetching
NEWSNOW_NAVIGATION_TIMEOUT_MS=60000
NEWSNOW_LINK_WAIT_TIMEOUT_MS=20000
NEWSNOW_MAX_DISCOVERED_CATEGORIES=8

# TickFlow market data
TICKFLOW_API_KEY=
TICKFLOW_BASE_URL=https://api.tickflow.org
# 每秒请求数（不设则用服务端默认）
# TICKFLOW_RPS=
