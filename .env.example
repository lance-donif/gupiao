# 基础设施
DATABASE_URL=postgresql://gupiao:password@localhost:5432/gupiaodb
REDIS_URL=redis://localhost:6379/0
# 生产 compose 必填（docker-compose.production.yml 启动时校验）
POSTGRES_PASSWORD=change-me

# HTTP 服务（backend/src/http/server.ts，默认 127.0.0.1:8787）
HOST=127.0.0.1
PORT=8787
NODE_ENV=development
# 覆盖后端根目录解析（默认取进程工作目录），一般不需要设置
# BACKEND_ROOT_DIR=

# ============ AI 配置（唯一来源就是本文件 + .env，子目录不再放任何配置文件）============
# 提供商列表：逗号分隔，顺序即调用优先级。每个提供商 id 需唯一。
AI_PROVIDER_IDS=deepseek-official,grok-heavy
# 提供商键名规则：id 转大写，非字母数字统一转下划线（如 deepseek-official → DEEPSEEK_OFFICIAL）。
# 下面以 DEEPSEEK_OFFICIAL 为例，grok-heavy 按同样规则配 GROK_HEAVY_* 即可。
AI_PROVIDER_DEEPSEEK_OFFICIAL_BASE_URL=https://api.deepseek.com
AI_PROVIDER_DEEPSEEK_OFFICIAL_API_KEY=
AI_PROVIDER_DEEPSEEK_OFFICIAL_MODELS=deepseek-flash
# 提供商级限流（可选：初始并发/最大并发/每分钟请求/每分钟 token/每日请求/每日 token/最小间隔毫秒/上下文 token）
AI_PROVIDER_DEEPSEEK_OFFICIAL_INITIAL_CONCURRENCY=2
AI_PROVIDER_DEEPSEEK_OFFICIAL_MAX_CONCURRENCY=5
AI_PROVIDER_DEEPSEEK_OFFICIAL_CONTEXT_TOKENS=1000000
# 提供商归属的配额组（可选，需在 AI_QUOTA_GROUPS 中定义）
# AI_PROVIDER_DEEPSEEK_OFFICIAL_QUOTA_GROUP=
# 模型级覆盖：序号对应 MODELS 列表顺序（MODEL_1_* 即第一个模型），可选
# 超时（毫秒）：首次响应/空闲/总超时；TIMEOUT_MS 为单个模型总超时
AI_PROVIDER_DEEPSEEK_OFFICIAL_MODEL_1_FIRST_RESPONSE_MS=120000
AI_PROVIDER_DEEPSEEK_OFFICIAL_MODEL_1_IDLE_MS=120000
AI_PROVIDER_DEEPSEEK_OFFICIAL_MODEL_1_TOTAL_MS=1800000
# 模型参数（可选）：是否流式/返回格式/推理强度/温度（数字或 null）/输出上限（二选一）
AI_PROVIDER_DEEPSEEK_OFFICIAL_MODEL_1_STREAM=true
AI_PROVIDER_DEEPSEEK_OFFICIAL_MODEL_1_REASONING_EFFORT=max
AI_PROVIDER_DEEPSEEK_OFFICIAL_MODEL_1_MAX_TOKENS=380000
# AI_PROVIDER_DEEPSEEK_OFFICIAL_MODEL_1_RESPONSE_FORMAT=json_object
# AI_PROVIDER_DEEPSEEK_OFFICIAL_MODEL_1_TEMPERATURE=
# AI_PROVIDER_DEEPSEEK_OFFICIAL_MODEL_1_MAX_COMPLETION_TOKENS=
# 模型级限流（可选，与提供商级同名字段，键为 MODEL_<序号>_INITIAL_CONCURRENCY 等）
AI_PROVIDER_DEEPSEEK_OFFICIAL_MODEL_1_CONTEXT_TOKENS=1000000
# 全局调度（可选：全局并发/单轮超时毫秒/最大尝试次数/初始批量/最大批量）
AI_SCHEDULING_GLOBAL_CONCURRENCY=10
AI_SCHEDULING_RUN_TIMEOUT_MS=3600000
AI_SCHEDULING_MAX_ATTEMPTS=24
# AI_SCHEDULING_INITIAL_BATCH_SIZE=
# AI_SCHEDULING_MAX_BATCH_SIZE=
# 新闻批量打包（可选：目标输入 token/最大输入 token/输出 token/每条新闻预估输出/目标延迟毫秒/最大新闻数）
AI_BATCHING_TARGET_INPUT_TOKENS=200000
AI_BATCHING_MAX_INPUT_TOKENS=400000
AI_BATCHING_OUTPUT_TOKENS=380000
AI_BATCHING_ESTIMATED_OUTPUT_TOKENS_PER_NEWS=512
AI_BATCHING_TARGET_LATENCY_MS=180000
AI_BATCHING_MAX_NEWS=64
# 配额组（可选）：逗号分隔的组名，每个组配与提供商级相同的限流字段
# AI_QUOTA_GROUPS=
# AI_QUOTA_GROUP_<组名大写>_MAX_CONCURRENCY=
# 自选股关键词生成 LLM 超时（默认 60000 毫秒）
AI_STOCK_KEYWORD_TIMEOUT_MS=60000
# 集成测试专用库（不设则集成测试跳过）
# AI_TEST_DATABASE_URL=postgresql://gupiao:password@localhost:5432/gupiaodb_test

# 因果信号抽取
CAUSAL_SIGNAL_EXTRACTOR=llm
# v3 逐条结果协议为默认；仅调试旧报文时才设为 legacy。
CAUSAL_PROTOCOL_MODE=items
CAUSAL_SIGNAL_BATCH_SIZE=50
CAUSAL_SIGNAL_LLM_REQUEST_TIMEOUT_MS=120000
# LLM 请求体上限（默认 240000，硬上限，见 AGENTS.md）
CAUSAL_SIGNAL_LLM_MAX_REQUEST_CHARS=240000
# 涨停证据初始化 LLM 请求体上限（不设则不限）
# EXPOSURE_CANDIDATE_MAX_REQUEST_CHARS=240000

# 推荐链路配方与阶段执行器（默认即生产强制切换值）
SCORING_RECIPE=event-v2
PIPELINE_STAGE_EXECUTOR=registry

# 流水线通用
# 多租户集群键（默认 global）
CLUSTER_KEY=global
# 新闻源模式：baseline | expanded（默认 expanded）
NEWS_SOURCE_MODE=expanded
# 扩展源：新浪财经/股票 JSON feed + Google News RSS
PUBLIC_NEWS_TIMEOUT_MS=12000
PUBLIC_NEWS_SOURCE_LIMIT=300
# 生产库写保护：import-trading-calendar 等脚本需 --allow-production 或设为 1
# ALLOW_PRODUCTION_WRITES=0

# AKTools 行情数据
AKTOOLS_BASE_URL=http://127.0.0.1:8010
AKTOOLS_BOARD_LIMIT=20
AKTOOLS_SYMBOL_LIMIT=20
AKTOOLS_MAX_RESULTS=10000

# 行情同步调参（scripts/sync-stock-history.ts，命令行参数优先）
STOCK_HISTORY_AKTOOLS_CONCURRENCY=32
STOCK_HISTORY_YAHOO_CONCURRENCY=16
STOCK_HISTORY_MAX_RETRIES=2
STOCK_HISTORY_YAHOO_FALLBACK=false
# 股票清单同步上限（0 = 不限，scripts/sync-stocks.ts）
STOCK_SYNC_LIMIT=0
# 股票清单快速同步（true 跳过慢步骤）
FAST_SYNC=false

# NewsNow 抓取
# 超时覆盖响应头和完整响应体；最多尝试 3 次
NEWSNOW_REQUEST_TIMEOUT_MS=60000
# NEWSNOW_MAX_SOURCES 不设置时请求全部来源

# TickFlow 行情数据
TICKFLOW_API_KEY=
TICKFLOW_BASE_URL=https://api.tickflow.org
# 每秒请求数（不设则用服务端默认）
# TICKFLOW_RPS=
