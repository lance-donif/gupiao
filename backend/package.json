{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript backend rewrite with strict OOP architecture.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:http": "bun run src/http/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:deps": "knip",
    "check:fix": "bun run typecheck && bun run test",
    "check:all": "bun run typecheck && bun run test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "keywords": [
    "typescript",
    "langchain",
    "deepagents",
    "prisma"
  ],
  "author": "",
  "license": "MIT",
  "trustedDependencies": ["prisma", "@prisma/engines", "esbuild"],
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "pg": "^8.21.0",
    "playwright": "^1.60.0",
    "prisma": "^7.8.0",
    "yahoo-finance2": "^3.14.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "dotenv": "^16.4.7",
    "knip": "^6.14.2",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
