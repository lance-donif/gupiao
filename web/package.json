{
  "name": "gupiao-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:style": "stylelint \"src/**/*.{css,html,tsx}\"",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \".github/**/*.md\"",
    "check:deps": "knip",
    "check:all": "bun run lint:style && bun run check:deps"
  },
  "knip": {
    "ignoreFiles": [],
    "ignoreDependencies": [
      "echarts"
    ],
    "ignoreExportsUsedInFile": {
      "type": true,
      "interface": true
    },
    "ignoreIssues": {
      "src/components/ui/select.tsx": ["exports"],
      "src/components/ui/sheet.tsx": ["exports"],
      "src/hooks/use-dashboard-data.ts": ["exports"],
      "src/lib/api.ts": ["exports"],
      "src/lib/api-types.ts": ["types"]
    }
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "lucide-react": "^1.16.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^7.15.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "jsdom": "^29.1.1",
    "knip": "^6.14.2",
    "markdownlint-cli2": "^0.22.1",
    "postcss": "^8.5.15",
    "postcss-html": "^1.8.1",
    "prettier": "^3.8.3",
    "stylelint": "^17.12.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-checker": "^0.13.0",
    "vitest": "^4.1.7"
  }
}
